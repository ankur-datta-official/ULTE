{
  "name": "ulte",
  "version": "0.0.0",
  "private": true,
  "description": "Universal Live Trading Engine monorepo",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "tsc --build && vitest run",
    "test:postgres": "tsc --noEmit --project tsconfig.postgres.json && vitest run --config vitest.postgres.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
